rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidSubmission(data) {
      return data.keys().hasAll(['usernameOrEmail', 'createdAt']) &&
             data.keys().size() >= 2 && data.keys().size() <= 3 &&
             data.usernameOrEmail is string && data.usernameOrEmail.size() > 0 && data.usernameOrEmail.size() <= 100 &&
             data.createdAt == request.time &&
             ( !('userId' in data) || (data.userId is string && data.userId.size() <= 128) );
    }

    function isValidWatchlistItem(data) {
      return data.keys().hasAll(['userId', 'mediaItemId', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.mediaItemId is string && data.mediaItemId.size() > 0 && data.mediaItemId.size() <= 128 &&
             data.createdAt == request.time;
    }

    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'moviesclip808@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }

    function isValidMediaItem(data) {
      // Allow flexible keys since we have many optional fields, but enforce core ones
      return data.keys().hasAll(['title', 'type', 'imageUrl']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.type is string && (data.type == 'MOVIE' || data.type == 'TV') &&
             data.imageUrl is string && data.imageUrl.size() <= 5000 &&
             // Optional fields validation
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('rating' in data) || (data.rating is string && data.rating.size() <= 10)) &&
             (!('year' in data) || (data.year is string && data.year.size() <= 10)) &&
             (!('quality' in data) || (data.quality is string && data.quality.size() <= 10)) &&
             (!('genre' in data) || (data.genre is string && data.genre.size() <= 50)) &&
             (!('country' in data) || (data.country is string && data.country.size() <= 50)) &&
             (!('network' in data) || (data.network is string && data.network.size() <= 50)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
             (!('cast' in data) || (data.cast is list && data.cast.size() <= 100)) &&
             (!('seasons' in data) || (data.seasons is list && data.seasons.size() <= 50)) &&
             (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 5000)) &&
             (!('bannerUrl' in data) || (data.bannerUrl is string && data.bannerUrl.size() <= 5000)) &&
             (!('duration' in data) || (data.duration is number || data.duration is string)) &&
             (!('featured' in data) || data.featured is bool) &&
             (!('trending' in data) || data.trending is bool) &&
             (!('status' in data) || data.status is string);
    }

    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'mediaItemId', 'reason', 'status', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.mediaItemId is string && data.mediaItemId.size() <= 128 &&
             data.reason is string && data.reason.size() <= 100 &&
             (!('details' in data) || (data.details is string && data.details.size() <= 1000)) &&
             data.status == 'pending' &&
             data.createdAt == request.time;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isValidId(reportId) && isValidReport(incoming());
      allow update, delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if false; // Only Admin can read
      allow create: if isValidId(submissionId) && isValidSubmission(incoming());
      allow update, delete: if false;
    }

    match /watchlist/{itemId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(itemId) && isValidWatchlistItem(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    function isValidCollection(data) {
      return data.keys().hasAll(['title']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 5000)) &&
             (!('mediaIds' in data) || (data.mediaIds is list && data.mediaIds.size() <= 1000)) &&
             (!('type' in data) || (data.type is string && (data.type == 'REGULAR' || data.type == 'CAST'))) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(collectionId) && isValidCollection(incoming());
      allow update: if isAdmin() && isValidCollection(incoming());
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    
    function isValidWatchProgress(data) {
      return data.keys().hasAll(['userId', 'mediaId', 'mediaType', 'progress', 'updatedAt', 'title', 'imageUrl']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.mediaId is string && data.mediaId.size() > 0 && data.mediaId.size() <= 128 &&
             data.mediaType is string && (data.mediaType == 'MOVIE' || data.mediaType == 'TV') &&
             data.progress is number && data.progress >= 0 &&
             (!('duration' in data) || data.duration is number) &&
             (!('seasonNumber' in data) || data.seasonNumber is number) &&
             (!('episodeNumber' in data) || data.episodeNumber is number) &&
             data.title is string && data.title.size() <= 200 &&
             data.imageUrl is string && data.imageUrl.size() <= 5000 &&
             data.updatedAt == request.time;
    }

    match /watch_progress/{progressId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(progressId) && isValidWatchProgress(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidWatchProgress(incoming()) && incoming().userId == existing().userId && incoming().mediaId == existing().mediaId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(mediaId) && isValidMediaItem(incoming());
      allow update: if isAdmin() && isValidMediaItem(incoming());
      allow delete: if isAdmin();
    }
  }
}
